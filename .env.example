# Public site. Used for sitemap, Open Graph, and absolute URLs.
NEXT_PUBLIC_SITE_URL=

# Supabase (optional until you switch the ledger off the JSON file).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessions. Required. Use a long random string.
SESSION_SECRET=

# Comma-separated emails that receive the admin role after they verify.
ADMIN_EMAILS=

# Email. Required for signup, login verification, and admin OTP on the live site.
# On Cloudflare Workers set RESEND_API_KEY or BREVO_API_KEY. SMTP_* still works on Node
# hosts such as Vercel and local next dev.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=

# PayUnit live rail. Required for deposits, withdrawals, and live API keys.
# PAYUNIT_MODE must be live or test. Do not leave it blank.
# PAYUNIT_BASE_URL should be https://gateway.payunit.net
# LBPAY_RETURN_URL and LBPAY_WEBHOOK_URL must be https.
PAYUNIT_API_KEY=
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_BASE_URL=https://gateway.payunit.net
PAYUNIT_MODE=
LBPAY_RETURN_URL=
LBPAY_WEBHOOK_URL=

# Cloudinary. Required for KYC identity photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lbpay/kyc

# Web Push. Optional. If omitted, LBPay generates and stores VAPID keys in the ledger.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@lbpay.cm

