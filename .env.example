NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL for sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://lbpay.cm

# Session HMAC. Required in production. Generate a long random string.
SESSION_SECRET=change-me-in-production

# Comma-separated emails that receive the admin role after they verify.
ADMIN_EMAILS=

# Email. Resend SMTP uses host smtp.resend.com, user resend, port 465 (SSL).
# EMAIL_FROM is the From address. SMTP_FROM is an optional override.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LBPay <noreply@lbpay.cm>
SMTP_FROM=

# Live rail. Empty = sandbox adapter even for live keys.
# Docs: https://developer.payunit.net  Host: https://gateway.payunit.net
PAYUNIT_API_KEY=
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_BASE_URL=https://gateway.payunit.net
PAYUNIT_MODE=test
LBPAY_RETURN_URL=http://localhost:3000/wallet
LBPAY_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/payunit
