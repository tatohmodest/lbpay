# Public site. Used for sitemap, Open Graph, and absolute URLs.
NEXT_PUBLIC_SITE_URL=

# Supabase (optional until you switch the ledger off the JSON file).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessions. Required. Use a long random string.
SESSION_SECRET=

# Comma-separated emails that receive the admin role after they verify.
ADMIN_EMAILS=

# Email. Required for signup, login verification, and admin OTP.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_FROM=

# PayUnit live rail. Required for deposits, withdrawals, and live API keys.
# PAYUNIT_MODE must be live or test. Do not leave it blank.
PAYUNIT_API_KEY=
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_BASE_URL=
PAYUNIT_MODE=
LBPAY_RETURN_URL=
LBPAY_WEBHOOK_URL=
