NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session HMAC. Change in production.
SESSION_SECRET=change-me-in-production

# Nodemailer SMTP — used to send email OTP after signup.
# Leave empty in local demo: the OTP is printed in the server log and returned as devOtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LBPay <noreply@lbpay.cm>

# Optional live rail. Leave empty to keep the sandbox adapter.
# Docs: https://developer.payunit.net  Host: https://gateway.payunit.net
PAYUNIT_API_KEY=
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_BASE_URL=https://gateway.payunit.net
PAYUNIT_MODE=test
LBPAY_RETURN_URL=http://localhost:3000/wallet
LBPAY_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/payunit
